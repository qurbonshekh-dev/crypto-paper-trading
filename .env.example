# Скопируй в .env и заполни. Файл .env в git не попадает.
MODE=dry                 # dry | testnet | live
BINANCE_API_KEY=
BINANCE_API_SECRET=
# LIVE_CONFIRM=YES       # раскомментировать ТОЛЬКО для реальных денег

LOT_USDT=10
MAX_POS=10
TP_PCT=1.5
SL_PCT=3.0               # стоп −3% (по бэктестам лучше −1%); поставь 1.0 для исходных правил
MOM_PCT=1.0
MOM_BARS=12
MAX_HOLD_H=24
DAILY_LOSS_STOP_PCT=5    # если за день просадка больше — новых входов до завтра нет
